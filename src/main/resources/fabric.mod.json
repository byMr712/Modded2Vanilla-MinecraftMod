{
  "schemaVersion": 1,
  "id": "modded2vanilla",
  "version": "${version}",
  "name": "[MR] Modded2Vanilla",
  "description": "Universal client-side compatibility layer. Seamlessly play with your favorite client content mods and join any vanilla/Paper/Spigot/ViaFabricPlus multiplayer servers without ID shifts, recipe conflicts, or entity tracker crashes.",
  "authors": [
    "byMr712"
  ],
  "contact": {
    "sources": "https://github.com/byMr712/Modded2Vanilla-MinecraftMod",
    "issues": "https://github.com/byMr712/Modded2Vanilla-MinecraftMod/issues",
    "homepage": "https://github.com/byMr712/Modded2Vanilla-MinecraftMod"
  },
  "license": "Apache-2.0",
  "icon": "assets/modded2vanilla/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.mr712.modded2vanilla.MrModded2VanillaFabric"
    ]
  },
  "mixins": [
    "modded2vanilla.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}